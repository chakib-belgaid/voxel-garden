{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.chakib-belgaid.com" }],
      "destination": "https://chakib-belgaid.github.io/$1",
      "permanent": true
    },
    { "source": "/fr/garden", "destination": "/garden", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ascii", "destination": "/ascii/index.html" },
    { "source": "/garden/:path*", "destination": "/garden/index.html" },
    { "source": "/fr/:path*", "destination": "/fr/404.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
