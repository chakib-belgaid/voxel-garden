{
  "name": "systems-garden-voxel-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "start": "vite --host 127.0.0.1 --port 4173",
    "map:build": "bun scripts/compile-world-map.ts --write",
    "map:check": "bun scripts/compile-world-map.ts --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/render.tsx --outDir .prerender",
    "prerender": "bun scripts/prerender.ts",
    "verify:recruiter-bundle": "bun scripts/verify-recruiter-bundle.ts",
    "build": "bun run typecheck && bun run typecheck:tools && bun run build:client && bun run verify:recruiter-bundle && bun run build:server && bun run prerender",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "bun run map:check && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/jersey-10": "^5.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
